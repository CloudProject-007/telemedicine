# ---- Runtime ----
NODE_ENV=development
PORT=4000
LOG_LEVEL=debug
# Number of reverse proxies in front of the app (1 = AWS ALB / CloudFront -> ALB)
TRUST_PROXY=1
# Comma separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173

# ---- Database (PostgreSQL) ----
DATABASE_URL=postgresql://telemed:telemed@localhost:5432/telemedicine?schema=public

# ---- Auth ----
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
JWT_ISSUER=telemedicine-api
JWT_AUDIENCE=telemedicine-clients
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800
BCRYPT_ROUNDS=12

# ---- Object storage (S3, or MinIO locally) ----
AWS_REGION=ap-south-1
S3_BUCKET=telemedicine-medical-files
# Leave empty on AWS. For MinIO use http://localhost:9000
S3_ENDPOINT=http://localhost:9000
S3_FORCE_PATH_STYLE=true
# Local MinIO credentials (on AWS use an IAM role instead and leave these empty)
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
UPLOAD_URL_TTL_SECONDS=300
DOWNLOAD_URL_TTL_SECONDS=300
UPLOAD_MAX_BYTES=10485760

# ---- Realtime / WebRTC ----
# Optional: set to enable the Socket.IO Redis adapter (required with >1 instance)
REDIS_URL=
STUN_URLS=stun:stun.l.google.com:19302
# Optional coturn (use-auth-secret mode). Comma separated, e.g. turn:turn.example.com:3478?transport=udp
TURN_URLS=
TURN_SECRET=
TURN_CREDENTIAL_TTL_SECONDS=3600
# Minutes before the scheduled start a call can be joined, and after the end it stays open
CALL_JOIN_EARLY_MINUTES=15
CALL_JOIN_LATE_MINUTES=30

# ---- Notifications (Amazon SNS) ----
# Public address of the web app, used for links inside messages
APP_URL=http://localhost:5173
NOTIFICATION_TIMEZONE=Asia/Kolkata
# Leave empty locally: messages are written to the log instead of being sent
SNS_TOPIC_ARN=

# ---- Reminders (EventBridge Scheduler -> SQS -> this app) ----
# Leave all four empty locally: no reminders are scheduled
SQS_REMINDER_QUEUE_URL=
SQS_REMINDER_QUEUE_ARN=
SCHEDULER_ROLE_ARN=
SCHEDULER_GROUP_NAME=telecare-reminders
# Set to false on an instance that should only serve HTTP
RUN_REMINDER_WORKER=true

# ---- CloudFront signed downloads (optional) ----
# Leave empty to use S3 pre-signed URLs. Set all three together.
CLOUDFRONT_DOMAIN=
CLOUDFRONT_KEY_PAIR_ID=
# PEM private key, with line breaks written as \n
CLOUDFRONT_PRIVATE_KEY=

# ---- Seed data (db:seed) ----
SEED_ADMIN_EMAIL=admin@telemed.local
SEED_ADMIN_PASSWORD=Admin@12345
